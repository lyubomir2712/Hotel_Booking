<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelBooking.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelBooking.Web.styles.css" asp-append-version="true" />
    <style>
      footer {
        padding: 0;
      }
      header {
        margin-bottom: 3rem;
      }
      #ai-fab {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #0d6efd;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(0,0,0,.3);
        cursor: pointer;
        z-index: 1051;
        user-select: none;
        font-weight: 700;
      }
      #ai-fab .close-icon { display: none; font-size: 28px; line-height: 1; }
      #ai-fab .ai-icon { font-size: 16px; line-height: 1; }
      #ai-fab.open .ai-icon { display: none; }
      #ai-fab.open .close-icon { display: inline; }

      #ai-chat-widget {
        position: fixed;
        right: 1rem;
        bottom: 5.5rem; 
        width: 360px;
        max-width: calc(100vw - 2rem);
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(4px);
        border-radius: 8px;
        padding: 0.75rem;
        z-index: 1050;
        display: none;
      }
      #ai-chat-widget.open { display: block; }
      
      #ai-chat-widget .ai-header {
        background: #0d6efd;
        color: #fff;
        font-weight: 700;
        padding: .5rem .75rem;
        margin: -0.75rem -0.75rem .5rem;
        border-radius: 8px 8px 0 0;
      }
      #ai-chat-widget .chat-messages {
        height: 260px;
        overflow-y: auto;
        padding-right: .25rem;
        display: flex;
        flex-direction: column;
        gap: .5rem;
      }
      #ai-chat-widget .message { display: flex; align-items: flex-end; gap: .5rem; }
      #ai-chat-widget .message.ai { justify-content: flex-start; }
      #ai-chat-widget .message.user { justify-content: flex-end; }
      #ai-chat-widget .bubble {
        max-width: 80%;
        padding: .5rem .75rem;
        border-radius: 6px;
        word-wrap: break-word;
        word-break: break-word;
        white-space: pre-wrap;
      }
      #ai-chat-widget .message.ai .bubble { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #fff; }
      #ai-chat-widget .message.user .bubble { background: #0d6efd; border: 1px solid #0d6efd; color: #fff; }
      #ai-chat-widget .ai-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #0d6efd;
        color: #fff !important;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
        flex: 0 0 28px;
        user-select: none;
        overflow: hidden; 
      }
      
      .container:has(.admin-panel-container) {
          margin-left: 0 !important;
          margin-right: 0 !important;
          padding-left: 0 !important;
          padding-right: 0 !important;
          max-width: 100% !important;
      }
      /* Admin toast notifications */
      #admin-toast-container {
        position: fixed;
        top: 1rem;
        right: 1rem;
        display: flex;
        flex-direction: column;
        gap: .5rem;
        z-index: 2000; /* above navbar and chat FAB (1051) */
        pointer-events: none; /* allow clicks through gaps */
      }
      .admin-toast {
        pointer-events: auto; /* clickable */
        min-width: 280px;
        max-width: 360px;
        background: #e6f4ea; /* light green */
        border: 1px solid #b7e0c2;
        color: #0f5132;
        border-left: 4px solid #27ae60;
        box-shadow: 0 8px 24px rgba(0,0,0,.15);
        border-radius: 8px;
        padding: .75rem .75rem .75rem .875rem;
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        opacity: 0;
        transform: translateY(-6px);
        transition: opacity .25s ease, transform .25s ease;
      }
      .admin-toast.show { opacity: 1; transform: translateY(0); }
      .admin-toast.hide { opacity: 0; transform: translateY(-6px); }
      .admin-toast .toast-icon {
        flex: 0 0 20px;
        width: 20px; height: 20px; border-radius: 50%;
        background: #27ae60; color: #fff; font-weight: 700; font-size: 12px;
        display: inline-flex; align-items: center; justify-content: center;
        line-height: 1;
        user-select: none;
      }
      .admin-toast .toast-body {
        flex: 1 1 auto;
        line-height: 1.2;
        word-wrap: break-word; word-break: break-word; white-space: normal;
      }
      .admin-toast .toast-close {
        background: transparent; border: 0; cursor: pointer;
        color: #0f5132; font-size: 18px; line-height: 1;
        padding: 0 .25rem; margin-left: .25rem;
        opacity: .7;
      }
      .admin-toast .toast-close:hover { opacity: 1; }
    </style>
</head>
<body>
    <header>
        <nav id = "navbar" class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-transparent box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" style="color: white; font-weight: bold; margin-left: 14rem;">EasyBook</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                  
                    @if (User.IsInRole("Admin"))
                    {
                    <a class="nav-link" style="color: white; " asp-controller="AdminPanel" asp-action="GetCheckoutedHotels">Admin panel</a>
                    }

                   
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div id="admin-toast-container" aria-live="polite" aria-atomic="false"></div>
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
<footer class="text-dark mt-auto">
  <div id="footer" class="container">
    <div class="row">
      <div class="col-md-4 text-center">
        <h6 class="text-uppercase">About Our App</h6>
        <p>Our booking hotels app helps travelers find the best deals on accommodations. We work with top hotels to provide the most competitive rates and help you save money on your next trip.</p>
      </div>
      <div class="col-md-4 text-center">
        <h6 class="text-uppercase">Contact Us</h6>
        <ul class="list-unstyled">
          <li>Email: info@easybook.com</li>
          <li>Phone:089-133-8778</li>
          <li>Address: 27 Main St, Sofia Bulgaira</li>
        </ul>
      </div>
      <div class="col-md-4 text-center">
        <h6 class="text-uppercase">Follow Us</h6>
        <ul class="list-unstyled">
          <li>Facebook</li>
          <li>Twitter</li>
          <li>Instagram</li>
          <li>LinkedIn</li>
        </ul>
      </div>
    </div>
            
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <p color="white" class="text-center">&copy; 2025 Booking Hotels App. All Rights Reserved.</p>
      </div>
    </div>
    </div>
</footer>


<div id="ai-chat-widget" aria-hidden="true">
        <div class="ai-header" role="heading" aria-level="2">EasyBook AI</div>
        <div id="aiMessages" class="chat-messages mb-2" role="log" aria-live="polite" aria-relevant="additions"></div>
        <div class="input-group">
            <input id="aiChatInput" class="form-control" type="text" placeholder="Ask EasyBook AI anything" />
            <button id="aiChatSend" class="btn btn-primary" type="button">Изпрати</button>
        </div>
    </div>
    <div id="ai-fab" role="button" aria-label="Open AI chat" aria-expanded="false">
      <span class="ai-icon">AI</span>
      <span class="close-icon" aria-hidden="true">&times;</span>
    </div>
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (User.IsInRole("Admin"))
{
    <script>
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/adminNotificationsHub")
            .withAutomaticReconnect()
            .configureLogging(signalR.LogLevel.Trace)
            .build();
        
        // Toast creation helper
        function createAdminToast(message) {
            var container = document.getElementById('admin-toast-container');
            if (!container) return;

            var toast = document.createElement('div');
            toast.className = 'admin-toast';
            toast.setAttribute('role', 'status');

            var icon = document.createElement('div');
            icon.className = 'toast-icon';
            icon.textContent = '✓';

            var body = document.createElement('div');
            body.className = 'toast-body';
            body.textContent = message || 'Ново известие';

            var close = document.createElement('button');
            close.className = 'toast-close';
            close.setAttribute('aria-label', 'Close notification');
            close.type = 'button';
            close.innerHTML = '&times;';

            close.addEventListener('click', function () {
                dismiss(true);
            });

            toast.appendChild(icon);
            toast.appendChild(body);
            toast.appendChild(close);
            container.appendChild(toast);

            // small async to allow transition
            requestAnimationFrame(function () {
                toast.classList.add('show');
            });

            // auto-dismiss after 10s with fade
            var hideTimer = setTimeout(function () {
                dismiss(false);
            }, 10000);

            function dismiss(isManual) {
                clearTimeout(hideTimer);
                toast.classList.add('hide');
                toast.classList.remove('show');
                // remove after transition
                setTimeout(function () {
                    if (toast && toast.parentNode) toast.parentNode.removeChild(toast);
                }, 300);
            }
        }

        connection.on('sendAdminNotificationForCheckout', function (message) {
            console.log('Admin notification received:', message);
            createAdminToast(message);
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        // Example: listening to server event
        
    </script>
}
<script>
      (function () {
        function appendUserMessage(text) {
          const messages = document.getElementById('aiMessages');
          if (!messages) return;
          const row = document.createElement('div');
          row.className = 'message user';
          const bubble = document.createElement('div');
          bubble.className = 'bubble';
          bubble.textContent = text;
          row.appendChild(bubble);
          messages.appendChild(row);
          messages.scrollTop = messages.scrollHeight;
        }

        function appendAiMessage(text) {
          const messages = document.getElementById('aiMessages');
          if (!messages) return;
          const row = document.createElement('div');
          row.className = 'message ai';
          const avatar = document.createElement('div');
          avatar.className = 'ai-avatar';
          avatar.textContent = 'AI';
          const bubble = document.createElement('div');
          bubble.className = 'bubble';
          bubble.textContent = text;
          row.appendChild(avatar);
          row.appendChild(bubble);
          messages.appendChild(row);
          messages.scrollTop = messages.scrollHeight;
        }

        async function sendAiChat() {
          const input = document.getElementById('aiChatInput');
          const messages = document.getElementById('aiMessages');
          if (!input || !messages) return;
          const msg = input.value.trim();
          if (!msg) return;

          appendUserMessage(msg);
          input.value = '';

          try {
            const res = await fetch('/Ai/AskAi?question=' + encodeURIComponent(msg), {
              method: 'GET',
              headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const answer = await res.text();
            appendAiMessage(answer || '[празен отговор]');
          } catch (err) {
            console.error('AI chat error:', err);
            appendAiMessage('Получи се грешка при изпращане на съобщението: "' + msg + '"');
          }
        }

        document.addEventListener('DOMContentLoaded', function () {
          const input = document.getElementById('aiChatInput');
          const btn = document.getElementById('aiChatSend');
          const widget = document.getElementById('ai-chat-widget');
          const fab = document.getElementById('ai-fab');

          function openWidget() {
            if (widget) {
              widget.classList.add('open');
              widget.setAttribute('aria-hidden', 'false');
            }
            if (fab) {
              fab.classList.add('open');
              fab.setAttribute('aria-label', 'Close AI chat');
              fab.setAttribute('aria-expanded', 'true');
            }
            if (input) input.focus();
          }

          function closeWidget() {
            if (widget) {
              widget.classList.remove('open');
              widget.setAttribute('aria-hidden', 'true');
            }
            if (fab) {
              fab.classList.remove('open');
              fab.setAttribute('aria-label', 'Open AI chat');
              fab.setAttribute('aria-expanded', 'false');
            }
          }

          if (fab) {
            fab.addEventListener('click', function () {
              if (fab.classList.contains('open')) {
                closeWidget();
              } else {
                openWidget();
              }
            });
          }

          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
              closeWidget();
            }
          });

          if (btn) btn.addEventListener('click', sendAiChat);
          if (input) {
            input.addEventListener('keydown', function (e) {
              if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendAiChat();
              }
            });
          }
        });
      })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
