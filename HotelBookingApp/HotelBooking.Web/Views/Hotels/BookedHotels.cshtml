@using HotelBooking.Models.AppModels
@using HotelBooking.Services.ViewModels
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Globalization
@model UserBookedHotels
<form asp-controller="BookingsCart" asp-action="CheckoutHotels" method="post">
    @for (int i = 0; i < Model.Bookings.Count; i++)
    {
        <input type="hidden" name="bookings[@i].Id" value="@Model.Bookings[i].Id" />
        <input type="hidden" name="bookings[@i].StartAt" value="@Model.Bookings[i].StartAt" />
        <input type="hidden" name="bookings[@i].EndAt" value="@Model.Bookings[i].EndAt" />
        <input type="hidden" name="bookings[@i].Price" value="@Model.Bookings[i].Price" />
        <input type="hidden" name="bookings[@i].HotelModel" value="@Model.Bookings[i].HotelModel" />
        <input type="hidden" name="bookings[@i].HotelModelId" value="@Model.Bookings[i].HotelModelId" />
        <input type="hidden" name="bookings[@i].AdultsNumber" value="@Model.Bookings[i].AdultsNumber" />
        <input type="hidden" name="bookings[@i].ChildrenNumber" value="@Model.Bookings[i].ChildrenNumber" />
        <input type="hidden" name="bookings[@i].RoomsNumber" value="@Model.Bookings[i].RoomsNumber" />
        <input type="hidden" name="bookings[@i].RapidApiHotelId" value="@Model.Bookings[i].RapidApiHotelId"/>
        <input type="hidden" name="bookings[@i].DestinationId" value="@Model.Bookings[i].DestinationId"/>
    }

    <button type="submit" class="btn btn-success"
            style="background:green;margin-left:84.5%; margin-bottom: 1%; width: 200px;"
            onmouseover="this.style.backgroundColor='darkgreen';"
            onmouseout="this.style.backgroundColor='green';">Check out</button>
</form>


<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; justify-content: center;">
    
    @foreach (var booking in Model.Bookings)
    {
        var hotel = booking.HotelModel;
        <div style="display: flex; justify-content: center;">
            <div class="card" style="width: 260px; margin: auto; border-radius:10px; overflow:hidden; height: 404px; position: relative;">
                <img src="@hotel.HotelImg" class="card-img-top" alt="..." style="height:200px; object-fit:cover;">
                <div class="card-body d-flex flex-column justify-content-between w-100">
                    <h5 class="card-title" style="font-weight: 600; font-size: 1.2rem; margin: 0 !important;">@hotel.HotelName</h5>
                    <p class="hotel-location" style="color:#000 !important;">@hotel.City, @hotel.Country</p>
                    <p class="hotel-address">@hotel.Address</p>
                    @{
                        var days = Math.Max(0, (booking.EndAt - booking.StartAt).Days);
                        var weeks = (days >= 7 && days % 7 == 0) ? days / 7 : 0;
                        var stayText = weeks > 0
                            ? (weeks == 1 ? "1 week" : weeks + " weeks")
                            : (days == 1 ? "1 day" : days + " days");
                    }
                    <p class="stay-line">
                        <span class="stay-detail">@stayText</span>, <span class="stay-detail">@booking.RoomsNumber</span> <span class="stay-detail">@(@booking.RoomsNumber == 1 ? "room" : "rooms")</span>, <span class="stay-detail">@booking.AdultsNumber</span> <span class="stay-detail">@(@booking.AdultsNumber == 1 ? "adult" : "adults")</span>
                        @if (booking.ChildrenNumber > 0)
                        {
                            @:<span class="stay-detail">and</span> <span class="stay-detail">@booking.ChildrenNumber</span> <span class="stay-detail">@((booking.ChildrenNumber == 1) ? "child" : "children")</span>
                        }
                    </p>
                    <div class="review-container">
                    <div class="review-score-badge">@Convert.ToDouble(hotel.ReviewScore, CultureInfo.InvariantCulture).ToString("0.0", CultureInfo.InvariantCulture)</div>
                        <div class="review-text">
                            <span class="review-word">@hotel.ReviewScoreWord</span>
                            <span class="review-count">@hotel.ReviewsCount reviews</span>
                        </div>
                    </div>
                    <p class="card-text" style="color:black; font-weight:600; font-size:1rem; position:absolute; bottom:10px; right:10px; margin:0;">EUR @booking.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</p>

                    <br><br>

                    <form asp-controller="BookingsCart" asp-action="RemoveHotel" method="post">
                        <input type="hidden" name="BookingId" value="@booking.Id"/>
                        <button type="submit" class="btn btn-danger"
                                style="position:absolute; top:10px; right:10px; width:30px; height:30px; border-radius:50%; padding:0; background:darkred; display:flex; align-items:center; justify-content:center;"
                                onmouseover="this.style.backgroundColor='rgb(120,0,0)';"
                                onmouseout="this.style.backgroundColor='darkred';">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <line x1="6" y1="6" x2="18" y2="18" stroke="white" stroke-width="3" stroke-linecap="round"/>
                                <line x1="6" y1="18" x2="18" y2="6" stroke="white" stroke-width="3" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .review-score-badge {
        background-color: #53B249;
        color: #fff;
        font-weight: 600;
        width: 37px;
        height: 37px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }
    .review-container {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.25rem;
    }
    .review-word {
        font-size: 0.85rem;
        font-weight: 500;
        color: #333;
    }
    .review-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }
    .review-count {
        font-size: 0.75rem;
        color: #6c757d;
    }
    .hotel-location {
        font-size: 0.85rem;
        color: #000;
        margin: 0;
    }
    .hotel-address {
        font-size: 0.8rem;
        color: #777;
        margin: 0;
    }
    .stay-line {
        font-size: 0.8rem;
        color: #555;
        margin-top: 0.15rem;
        margin-bottom: 0;
    }
    .stay-length { font-weight: 500; }
    .stay-detail {
        color: #777;
    }
</style>
<div id="add-to-cart-template" style="display:none;">
    <form asp-controller="BookingsCart" asp-action="AddToCart" method="post" class="toast-add-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="HotelName" value="" class="tpl-HotelName" />
        <input type="hidden" name="HotelImg" value="" class="tpl-HotelImg" />
        <input type="hidden" name="HotelPrice" value="" class="tpl-HotelPrice" />
        <input type="hidden" name="StartAt" value="" class="tpl-StartAt" />
        <input type="hidden" name="EndAt" value="" class="tpl-EndAt" />
        <input type="hidden" name="City" value="" class="tpl-City" />
        <input type="hidden" name="Country" value="" class="tpl-Country" />
        <input type="hidden" name="Address" value="" class="tpl-Address" />
        <input type="hidden" name="ReviewScore" value="" class="tpl-ReviewScore" />
        <input type="hidden" name="ReviewScoreWord" value="" class="tpl-ReviewScoreWord" />
        <input type="hidden" name="ReviewsCount" value="" class="tpl-ReviewsCount" />
        <input type="hidden" name="RoomsNumber" value="" class="tpl-RoomsNumber" />
        <input type="hidden" name="AdultsNumber" value="" class="tpl-AdultsNumber" />
        <input type="hidden" name="ChildrenNumber" value="" class="tpl-ChildrenNumber" />
        <input type="hidden" name="RapidApiHotelId" value="" class="tpl-RapidApiHotelId" />
        <input type="hidden" name="DestinationId" value="" class="tpl-DestinationId" />
        <button type="submit" class="btn book-btn" style="background:#53B249; border-color:#53B249; color:#fff;">Book</button>
    </form>
</div>
<script src="~/lib/signalr/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/bookingRecommendationsHub")
        .withAutomaticReconnect()
        .configureLogging(signalR.LogLevel.Trace)
        .build();

    function createUnavailableToast(message) {
        var container = document.getElementById('unavailable-toast-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'unavailable-toast-container';
            container.setAttribute('aria-live', 'polite');
            container.setAttribute('aria-atomic', 'false');
            container.style.position = 'fixed';
            container.style.top = '1rem';
            container.style.right = '1rem';
            container.style.display = 'flex';
            container.style.flexDirection = 'column';
            container.style.gap = '0.5rem';
            container.style.zIndex = '2050';
            container.style.pointerEvents = 'none';
            document.body.appendChild(container);
        }

        var toast = document.createElement('div');
        toast.className = 'unavailable-toast';
        toast.setAttribute('role', 'status');
        toast.style.pointerEvents = 'auto';
        toast.style.minWidth = '280px';
        toast.style.maxWidth = '360px';
        toast.style.background = '#fdecea';
        toast.style.border = '1px solid #f5c2c7';
        toast.style.color = '#842029';
        toast.style.borderLeft = '4px solid #d9534f';
        toast.style.boxShadow = '0 8px 24px rgba(0,0,0,.15)';
        toast.style.borderRadius = '8px';
        toast.style.padding = '.75rem .75rem .75rem .875rem';
        toast.style.display = 'flex';
        toast.style.alignItems = 'flex-start';
        toast.style.gap = '.75rem';
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-6px)';
        toast.style.transition = 'opacity .25s ease, transform .25s ease';

        var icon = document.createElement('div');
        icon.className = 'toast-icon';
        icon.textContent = '✖';
        icon.style.flex = '0 0 20px';
        icon.style.width = '20px';
        icon.style.height = '20px';
        icon.style.borderRadius = '50%';
        icon.style.background = '#d9534f';
        icon.style.color = '#fff';
        icon.style.fontWeight = '700';
        icon.style.fontSize = '12px';
        icon.style.display = 'inline-flex';
        icon.style.alignItems = 'center';
        icon.style.justifyContent = 'center';
        icon.style.lineHeight = '1';
        icon.style.userSelect = 'none';

        var body = document.createElement('div');
        body.className = 'toast-body';
        body.style.flex = '1 1 auto';
        body.style.lineHeight = '1.2';
        body.style.wordWrap = 'break-word';
        body.style.wordBreak = 'break-word';
        body.style.whiteSpace = 'normal';
        body.textContent = message;

        var close = document.createElement('button');
        close.className = 'toast-close';
        close.setAttribute('aria-label', 'Close notification');
        close.type = 'button';
        close.innerHTML = '&times;';
        close.style.background = 'transparent';
        close.style.border = '0';
        close.style.cursor = 'pointer';
        close.style.color = '#842029';
        close.style.fontSize = '18px';
        close.style.lineHeight = '1';
        close.style.padding = '0 .25rem';
        close.style.marginLeft = '.25rem';
        close.style.opacity = '.7';

        close.addEventListener('click', function () {
            dismiss(true);
        });

        toast.appendChild(icon);
        toast.appendChild(body);
        toast.appendChild(close);
        container.appendChild(toast);

        requestAnimationFrame(function () {
            toast.style.opacity = '1';
            toast.style.transform = 'translateY(0)';
        });

        var hideTimer = setTimeout(function () {
            dismiss(false);
        }, 10000);

        function dismiss(isManual) {
            clearTimeout(hideTimer);
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(-6px)';
            setTimeout(function () {
                if (toast && toast.parentNode) toast.parentNode.removeChild(toast);
            }, 300);
        }
    }

    function createRecommendedToast(hotel) {
        var container = document.getElementById('recommended-toast-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'recommended-toast-container';
            container.setAttribute('aria-live', 'polite');
            container.setAttribute('aria-atomic', 'false');
            container.style.position = 'fixed';
            container.style.bottom = '1rem';
            container.style.right = '1rem';
            container.style.display = 'flex';
            container.style.flexDirection = 'row-reverse'; 
            container.style.gap = '0.75rem';
            container.style.zIndex = '2050';
            container.style.pointerEvents = 'none';
            document.body.appendChild(container);
        }
       
        var name = hotel?.HotelName || hotel?.Name || hotel?.name || hotel?.hotelName || 'Recommended Hotel';
        var city = hotel?.City || hotel?.city || '';
        var country = hotel?.Country || hotel?.country || '';
        var price = hotel?.Price || hotel?.price;
        var imgSrc = hotel?.photoMainUrl || '';
        
        var reviewScore = '';
        if (hotel?.ReviewScore !== undefined && hotel?.ReviewScore !== null) reviewScore = hotel.ReviewScore;
        else if (hotel?.reviewScore !== undefined && hotel?.reviewScore !== null) reviewScore = hotel.reviewScore;
        else if (hotel?.Review_Score !== undefined && hotel?.Review_Score !== null) reviewScore = hotel.Review_Score;
        else if (hotel?.review_score !== undefined && hotel?.review_score !== null) reviewScore = hotel.review_score;
        else if (hotel?.ReviewScoreNumeric !== undefined && hotel?.ReviewScoreNumeric !== null) reviewScore = hotel.ReviewScoreNumeric;
        if (reviewScore !== '' && reviewScore !== null && reviewScore !== undefined) reviewScore = String(reviewScore);

        var reviewScoreStr = '';
        if (reviewScore !== '' && isFinite(Number(reviewScore))) {
            var scoreNum = Number(reviewScore);
            try {
                reviewScoreStr = scoreNum.toLocaleString('bg-BG', { useGrouping: false, maximumFractionDigits: 3 });
            } catch (e) {
                reviewScoreStr = scoreNum.toString();
            }
        }
        var reviewsCount = hotel?.ReviewsCount || hotel?.reviewsCount || '';
        var hotelUrl = hotel?.Url || hotel?.HotelUrl || hotel?.Link || '#';

        var startAt = hotel?.StartAt || hotel?.startAt || hotel?.StartDate || hotel?.start_date || '';
        var endAt = hotel?.EndAt || hotel?.endAt || hotel?.EndDate || hotel?.end_date || '';
        var reviewScoreWord = hotel?.ReviewScoreWord || hotel?.reviewScoreWord || hotel?.ReviewWord || hotel?.review_word || '';
        var rapidApiId = hotel?.HotelId || hotel?.RapidApiHotelId || hotel?.RapidApiId || hotel?.Id || hotel?.hotelId || hotel?.hotel_id || hotel?.rapidApiHotelId || hotel?.rapid_api_hotel_id || '';
        var destinationId = hotel?.DestinationId || hotel?.destinationId || hotel?.Destination || hotel?.destination_id || '';
        var addressNormalized = hotel?.Address || hotel?.address || hotel?.AddressLine || hotel?.address_line || '';

        

        var toast = document.createElement('div');
        toast.className = 'recommended-hotel-card';
        toast.style.pointerEvents = 'auto';
        toast.style.width = '260px';
        toast.style.height = '404px';
        toast.style.position = 'relative';
        toast.style.borderRadius = '10px';
        toast.style.overflow = 'hidden';
        toast.style.background = '#fff';
        toast.style.border = '1px solid rgba(0,0,0,0.08)';
        toast.style.boxShadow = '0 8px 24px rgba(0,0,0,.12)';
        toast.style.display = 'flex';
        toast.style.flexDirection = 'column';
        toast.style.fontFamily = 'inherit';
        toast.style.transition = 'transform .22s ease, opacity .22s ease';
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(12px)';
        toast.style.display = 'block';

        var imgEl = document.createElement('img');
        imgEl.src = imgSrc;
        imgEl.alt = name;
        imgEl.style.width = '100%';
        imgEl.style.height = '200px';
        imgEl.style.objectFit = 'cover';
        imgEl.style.display = 'block';

        imgEl.onerror = function () { this.onerror = null; this.src = '/images/hotel-placeholder.png'; };
        var badge = document.createElement('div');
        badge.className = 'recommended-badge';
        badge.textContent = 'Recommended';
        badge.setAttribute('aria-hidden', 'true');
        badge.style.position = 'absolute';
        badge.style.top = '8px';
        badge.style.left = '8px';
        badge.style.background = '#53B249';
        badge.style.color = '#fff';
        badge.style.fontWeight = '600';
        badge.style.fontSize = '0.75rem';
        badge.style.padding = '4px 8px';
        badge.style.borderRadius = '6px';
        badge.style.boxShadow = '0 4px 10px rgba(0,0,0,0.12)';
        badge.style.zIndex = '10';
        toast.appendChild(badge);
        toast.appendChild(imgEl);

        var body = document.createElement('div');
        body.className = 'card-body d-flex flex-column justify-content-between w-100';
     
        body.style.position = 'absolute';
        body.style.top = '215px';
        body.style.left = '10px';
        body.style.right = '10px';
        body.style.bottom = '60px';
        body.style.display = 'block';
        body.style.padding = '0';
        body.style.margin = '0';
        body.style.width = '100%';
        body.style.boxSizing = 'border-box';

        var title = document.createElement('div');
        title.style.fontWeight = '600';
        title.style.fontSize = '1.15rem';
        title.style.color = '#111';
        title.textContent = name;
        var location = document.createElement('div');
        location.style.fontSize = '0.85rem';
        location.style.color = '#000';
        location.textContent = (city || country) ? (city + (city && country ? ', ' : '') + country) : '';
        var stayLine = document.createElement('div');
        stayLine.style.fontSize = '0.8rem';
        stayLine.style.color = '#555';
        stayLine.style.marginTop = '0.15rem';

        var rooms = hotel?.RoomsNumber || hotel?.roomsNumber || '';
        var adults = hotel?.AdultsNumber || hotel?.adultsNumber || '';
        var children = hotel?.ChildrenNumber || hotel?.childrenNumber || '';
        var stayParts = [];

        var days = '';
        if (startAt && endAt) {
            try {
                var sd = new Date(startAt);
                var ed = new Date(endAt);
                if (!isNaN(sd) && !isNaN(ed)) {
                    var diff = Math.ceil((ed - sd) / (1000 * 60 * 60 * 24));
                    if (diff < 0) diff = 0;
                    days = diff;
                }
            } catch (e) { days = ''; }
        }
        if (days) {
            stayParts.push(days + (Number(days) === 1 ? ' day' : ' days'));
        }
        if (rooms) stayParts.push(rooms + (Number(rooms) === 1 ? ' room' : ' rooms'));
        if (adults) stayParts.push(adults + (Number(adults) === 1 ? ' adult' : ' adults'));
        if (children) stayParts.push(children + (Number(children) === 1 ? ' child' : ' children'));
        stayLine.textContent = stayParts.join(', ');
        var bottomRow = document.createElement('div');
        bottomRow.style.display = 'flex';
        bottomRow.style.alignItems = 'center';
        bottomRow.style.gap = '.5rem';
        bottomRow.style.marginTop = '0';
        title.style.position = 'absolute';
        title.style.top = '2px';
        title.style.left = '0';
        location.style.position = 'absolute';
        location.style.top = '24px';
        location.style.left = '0';
        stayLine.style.position = 'absolute';
        stayLine.style.top = '44px';
        stayLine.style.left = '0';
        bottomRow.style.position = 'absolute';
        bottomRow.style.top = '66px';
        bottomRow.style.left = '0';

        var reviewBadge = document.createElement('div');
        reviewBadge.textContent = reviewScore ? Number(reviewScore).toFixed(1) : '';
        reviewBadge.style.background = '#53B249';
        reviewBadge.style.color = '#fff';
        reviewBadge.style.fontWeight = '600';
        reviewBadge.style.width = '34px';
        reviewBadge.style.height = '34px';
        reviewBadge.style.display = 'flex';
        reviewBadge.style.justifyContent = 'center';
        reviewBadge.style.alignItems = 'center';
        reviewBadge.style.borderRadius = '50%';
        reviewBadge.style.flex = '0 0 auto';

        var reviewText = document.createElement('div');
        reviewText.style.display = 'flex';
        reviewText.style.flexDirection = 'column';
        reviewText.style.lineHeight = '1.2';
        reviewText.style.marginLeft = '0.25rem';

        var reviewWordEl = document.createElement('span');
        reviewWordEl.textContent = reviewScoreWord || '';
        reviewWordEl.style.fontSize = '0.85rem';
        reviewWordEl.style.fontWeight = '500';
        reviewWordEl.style.color = '#333';

        var reviewCountEl = document.createElement('span');
        reviewCountEl.textContent = reviewsCount ? (reviewsCount + ' reviews') : '';
        reviewCountEl.style.fontSize = '0.75rem';
        reviewCountEl.style.color = '#6c757d';

        reviewText.appendChild(reviewWordEl);
        reviewText.appendChild(reviewCountEl);

        bottomRow.appendChild(reviewBadge);
        bottomRow.appendChild(reviewText);

        var priceAbsolute = document.createElement('div');
        priceAbsolute.style.position = 'absolute';
        priceAbsolute.style.bottom = '50px';
        priceAbsolute.style.right = '10px';
        priceAbsolute.style.fontWeight = '700';
        priceAbsolute.style.color = '#000';
        priceAbsolute.textContent = price ? ('EUR ' + Number(price).toFixed(2)) : '';

        body.appendChild(title);
        body.appendChild(location);
        body.appendChild(stayLine);
        body.appendChild(bottomRow);

        toast.appendChild(priceAbsolute);

        (function() {
            var templateRoot = document.getElementById('add-to-cart-template');
            if (!templateRoot || !templateRoot.firstElementChild) {
                console.warn('Add-to-cart Razor template not found; skipping Razor form injection.');
                return;
            }

            var clonedForm = templateRoot.firstElementChild.cloneNode(true);

            function setTpl(selector, value) {
                var el = clonedForm.querySelector(selector);
                var str = (value !== undefined && value !== null) ? String(value) : '';
                if (el) {
                    el.value = str;
                    try { el.setAttribute('value', str); } catch (e) {  }
                }
            }

            setTpl('.tpl-HotelName', name);
            setTpl('.tpl-HotelImg', imgSrc);
            setTpl('.tpl-HotelPrice', price);
            setTpl('.tpl-StartAt', startAt);
            setTpl('.tpl-EndAt', endAt);
            setTpl('.tpl-City', city);
            setTpl('.tpl-Country', country);
            setTpl('.tpl-Address', addressNormalized);

            var reviewScoreFormatted = '';
            if (reviewScore !== '' && isFinite(Number(reviewScore))) {
                try {
                    
                    reviewScoreFormatted = Number(reviewScore).toLocaleString('bg-BG', { useGrouping: false, maximumFractionDigits: 3 });
                } catch (e) {
                    reviewScoreFormatted = Number(reviewScore).toString();
                }
            }
            setTpl('.tpl-ReviewScore', reviewScoreFormatted);

            setTpl('.tpl-ReviewScoreWord', reviewScoreWord);
            setTpl('.tpl-ReviewsCount', reviewsCount);
            setTpl('.tpl-RoomsNumber', rooms);
            setTpl('.tpl-AdultsNumber', adults);
            setTpl('.tpl-ChildrenNumber', children);
            setTpl('.tpl-RapidApiHotelId', rapidApiId);
            setTpl('.tpl-DestinationId', destinationId);

            clonedForm.addEventListener('click', function (ev) { ev.stopPropagation(); });
            var _submitBtn = clonedForm.querySelector('button[type="submit"]');
            if (_submitBtn) {
                _submitBtn.addEventListener('click', function (ev) { ev.stopPropagation();  });
            }

            clonedForm.addEventListener('submit', function (ev) {
                try {
                    var fd = new FormData(clonedForm);
                    var parts = [];
                    for (var pair of fd.entries()) parts.push(pair[0] + '=' + pair[1]);
                    console.log('Debug: AddToCart form submit payload:', parts.join('&'));
                } catch (e) { console.warn('Debug: failed to serialize form data for logging', e); }
            });

            clonedForm.style.position = 'absolute';
            clonedForm.style.right = '10px';
            clonedForm.style.bottom = '10px';
            clonedForm.style.margin = '0';
            clonedForm.style.padding = '0';

            toast.appendChild(clonedForm);
        })();

        toast.addEventListener('click', function (e) {
            if (hotelUrl && hotelUrl !== '#') {
                window.open(hotelUrl, '_blank');
            }
        });

        toast.appendChild(body);

        var close = document.createElement('button');
        close.className = 'toast-close';
        close.setAttribute('aria-label', 'Close notification');
        close.type = 'button';
        close.innerHTML = '&times;';
        close.style.position = 'absolute';
        close.style.top = '6px';
        close.style.right = '8px';
        close.style.background = 'transparent';
        close.style.border = '0';
        close.style.cursor = 'pointer';
        close.style.color = 'rgba(0,0,0,0.6)';
        close.style.fontSize = '16px';
        close.style.lineHeight = '1';
        close.style.padding = '0';
        close.style.zIndex = '20';

        var wrapper = document.createElement('div');
        wrapper.style.position = 'relative';
        wrapper.style.pointerEvents = 'auto';
        wrapper.style.zIndex = '2060';
        wrapper.appendChild(toast);
        wrapper.appendChild(close);

        container.appendChild(wrapper);

        requestAnimationFrame(function () {
            toast.style.opacity = '1';
            toast.style.transform = 'translateY(0)';
        });

        var hideTimer = setTimeout(function () {
            dismiss(false);
        }, 30000);

        close.addEventListener('click', function (e) { e.stopPropagation(); e.preventDefault(); dismiss(true); });

        function dismiss(isManual) {
            clearTimeout(hideTimer);
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(12px)';
            setTimeout(function () {
                if (wrapper && wrapper.parentNode) wrapper.parentNode.removeChild(wrapper);
            }, 300);
        }
    }

    function showRecommendedToasts(recommendedArray) {
        if (!Array.isArray(recommendedArray) || recommendedArray.length === 0) return;

        recommendedArray.forEach(function (hotel) {
            if (typeof hotel === 'string') {
                try { hotel = JSON.parse(hotel); } catch (e) { hotel = { Name: hotel }; }
            }
            createRecommendedToast(hotel);
        });
    }

    function escapeHtml(str) {
        if (!str && str !== 0) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function showUnavailableToast(names) {
        var text = '';
        if (!Array.isArray(names) || names.length === 0) {
            text = 'Sorry, some bookings are currently unavailable.';
        } else if (names.length === 1) {
            text = 'Sorry, ' + names[0] + ' is currently unavailable.';
        } else if (names.length === 2) {
            text = 'Sorry, ' + names[0] + ' and ' + names[1] + ' are currently unavailable.';
        } else {
            var last = names.slice(-1)[0];
            var rest = names.slice(0, -1);
            text = 'Sorry, ' + rest.join(', ') + ', and ' + last + ' are currently unavailable.';
        }
        createUnavailableToast(text);
    }

    connection.on("ReceiveUnavailableBookingsAndBookingRecommendation", (hotelPayload) => {
        try {
            console.log("SignalR: Received unavailable bookings + recommendations payload:", hotelPayload);
            var names = hotelPayload?.unavailableBookingHotelNames || hotelPayload?.UnavailableBookings || hotelPayload?.unavailableBookings || hotelPayload?.UnavailableBookingHotelNames || [];
            var recommended = hotelPayload?.RecommendedHotels || hotelPayload?.recommendedHotels || hotelPayload?.Recommended || hotelPayload?.recommendations || hotelPayload?.recommended || [];

            if (recommended && !Array.isArray(recommended) && recommended.RecommendedHotels) {
                recommended = recommended.RecommendedHotels;
            }

            if (typeof recommended === 'string') {
                try { recommended = JSON.parse(recommended); } catch (e) {  }
            }

            if (!Array.isArray(recommended) && recommended) {
                recommended = [recommended];
            }
            
            if (Array.isArray(recommended) && recommended.length > 0) {
                showRecommendedToasts(recommended);
            }
            
            showUnavailableToast(Array.isArray(names) ? names : []);
        } catch (err) {
            console.error('SignalR handler error (ReceiveUnavailableBookingsAndBookingRecommendation):', err);
        }
    });

    connection.on("ReceiveUnavailableBookings", (unavailableBookingNames) => {
        try {
            console.log('SignalR: Received unavailable bookings only:', unavailableBookingNames);
            var names = unavailableBookingNames || [];
            showUnavailableToast(Array.isArray(names) ? names : []);
        } catch (err) {
            console.error('SignalR handler error (ReceiveUnavailableBookings):', err);
        }
    });

    connection.start()
        .then(() => console.log("Connected to HotelRecommendationsHub"))
        .catch(err => console.error("Connection failed:", err));
</script>