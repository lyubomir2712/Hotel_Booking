@using HotelBooking.Services.ViewModels;
@using System.Globalization
@model List<Hotel>? 

<div class="row row-cols-1 g-4">
    @{
        if (Model != null)
        {
            foreach (var hotel in Model)
            {
                <div class="col">
                    <div class="card h-100 hotel-card mx-auto overflow-hidden">
                        <div class="review-top">
                            <div class="review-label">
                                <span class="review-word">@hotel.ReviewScoreWord</span>
                                <span class="review-count">@hotel.ReviewsCount reviews</span>
                            </div>
                            <div class="review-score-badge">@Convert.ToDouble(hotel.ReviewScore, CultureInfo.InvariantCulture).ToString("0.0", CultureInfo.InvariantCulture)</div>
                        </div>
                        <div class="row g-0 align-items-stretch">
                            <div class="col-5 col-md-4">
                                <img src="@hotel.PhotoMainUrl" class="img-fluid w-100 h-100 hotel-card-img" alt="@hotel.Name">
                            </div>
                            <div class="col-7 col-md-8 d-flex">
                                <div class="card-body d-flex flex-column justify-content-between w-100">
                                    <div>
                                        <h5 class="card-title">@hotel.Name</h5>
                                        <p class="card-text mb-1"><span>Dates: </span><span class="start">@hotel.StartAt</span><span>-</span><span class="end">@hotel.EndAt</span></p>
                                        </div>
                                        <div class="purchase-cta d-flex flex-column align-items-end gap-1 align-self-end">
                                            <p class="card-text mb-1 text-end"><span class="price-amount">BGN @String.Format("{0:0.00}", hotel.Price)</span></p>
                                            <form asp-controller="BookingsCart" asp-action="AddToCart" method="post">
                                                <input type="hidden" name="HotelName" value="@hotel.Name"/>
                                                <input type="hidden" name="HotelImg" value="@hotel.PhotoMainUrl"/>
                                                <input type="hidden" name="HotelPrice" value="@hotel.Price"/>
                                                <input type="hidden" name="StartAt" value="@hotel.StartAt"/>
                                                <input type="hidden" name="EndAt" value="@hotel.EndAt"/>
                                                <button type="submit" class="btn btn-dark">Book</button>
                                            </form>
                                        </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
    </div >

        <style>
    .hotel-card {
        border-radius: 0.75rem;
        width: 100%;
        padding-inline: 1rem;
        padding-block: 1rem;
        padding-top: 1rem; padding-bottom: 1rem; /* fallback for older browsers */
        max-width: 780px; /* even less wide */
        position: relative;
    }
    .hotel-card-img {
        object-fit: cover;
        height: 100%;
        min-height: 220px; /* ensure some height even with little text */
        border-radius: 0.5rem; /* rounded corners for the image */
    }
    .hotel-card .card-body {
        padding: 1rem 1.25rem;
    }
    .hotel-card .card-title {
        margin-bottom: 0.5rem;
    }
    span {
        color: black
    }

    .price-amount {
        font-size: 1.1rem;
        line-height: 1.1;
        color: black;
    }

    .review-top {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        z-index: 2;
    }
    .review-word {
        font-weight: 600;
        font-size: 0.85rem;
        line-height: 1;
        white-space: nowrap;
        /* plain text – no pill styling */
        padding: 0;
        background: none;
        border-radius: 0;
        color: inherit;
    }
    .review-label {
        display: flex;
        flex-direction: column;
        align-items: flex-end; /* right-align in a column */
        gap: 0.125rem;
        text-align: right;
    }
    .review-count {
        font-size: 0.75rem;
        color: #6c757d; /* Bootstrap secondary */
        line-height: 1;
    }
    .review-score-badge {
        background-color: #003b95; /* Bootstrap primary blue */
        color: #fff;
        font-weight: 700;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-top-left-radius: 0.5rem;
        border-top-right-radius: 0.5rem;
        border-bottom-right-radius: 0.5rem;
        border-bottom-left-radius: 0;
    }
</style>
