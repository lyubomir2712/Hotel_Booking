@using HotelBooking.Services.ViewModels;
@using System.Globalization
@model List<BookingViewModel>? 

<div class="row row-cols-1 g-4">
    @{
        if (Model != null)
        {
            foreach (var hotel in Model)
            {
                <div class="col">
                    <div class="card h-100 hotel-card mx-auto overflow-hidden">
                        <div class="review-top review-absolute">
                            <div class="review-label">
                                <span class="review-word">@hotel.ReviewScoreWord</span>
                                <span class="review-count">@hotel.ReviewsCount reviews</span>
                            </div>
                            <div class="review-score-badge">@Convert.ToDouble(hotel.ReviewScore, CultureInfo.InvariantCulture).ToString("0.0", CultureInfo.InvariantCulture)</div>
                        </div>
                        <div class="row g-0 align-items-stretch">
                            <div class="col-5 col-md-4">
                                <img src="@hotel.PhotoMainUrl" class="img-fluid w-100 h-100 hotel-card-img" alt="@hotel.Name">
                            </div>
                            <div class="col-7 col-md-8 d-flex">
                                <div class="card-body d-flex flex-column justify-content-between w-100">
                                    <div>
                                        <h5 class="card-title hotel-name position-absolute">@hotel.Name</h5>
                                        @if (!string.IsNullOrEmpty(hotel.AccommodationType))
                                        {
                                            <div class="card-subtitle mb-1 accommodation-type">@hotel.AccommodationType</div>
                                        }
                                        <div class="card-text mb-2 d-flex flex-wrap align-items-center gap-2" style="font-size: 0.75rem;">
                                            <span class="city-country">@hotel.City, @hotel.Country</span>
                                            <div class="w-100"></div>
                                            <span class="hotel-address">@hotel.Address</span>
                                            @if (hotel.Latitude != null && hotel.Longitude != null)
                                            {
                                                <div class="w-100"></div>
                                                <div class="map-info">
                                                    <a target="_blank"
                                                       href="https://www.google.com/maps/search/?api=1&query=@hotel.Latitude,@hotel.Longitude">
                                                        View on Map
                                                    </a>
                                                    @if (hotel.DistanceToCenter != null)
                                                    {
                                                        <span>@($"{hotel.DistanceToCenter:F1} km from city centre")</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        @if (false) { } <!-- placeholder to keep Razor happy -->
                                        @{
                                            var tags = new List<string>();
                                            if (hotel.IsFreeCancellable == true) tags.Add("Cancellable");
                                            if (hotel.IsNoPrepayment == true) tags.Add("No prepayment required – pay at the property");
                                            if (hotel.HasFreeParking == true) tags.Add("Free parking");
                                        }
                                        <div class="d-flex justify-content-between align-items-center mt-auto w-100">
                                            <div class="hotel-benefits">@string.Join(", ", tags)</div>
                                            <div class="purchase-cta d-flex flex-column align-items-end gap-1">
                                                @{
                                                    var startDate2 = Convert.ToDateTime(hotel.StartAt, CultureInfo.InvariantCulture);
                                                    var endDate2 = Convert.ToDateTime(hotel.EndAt, CultureInfo.InvariantCulture);
                                                    var days2 = Math.Max(0, (endDate2 - startDate2).Days);
                                                    var weeks2 = (days2 >= 7 && days2 % 7 == 0) ? days2 / 7 : 0;
                                                    var stayText2 = weeks2 > 0
                                                        ? (weeks2 == 1 ? "1 week" : weeks2 + " weeks")
                                                        : (days2 == 1 ? "1 day" : days2 + " days");
                                                }
                                                <p class="card-text mb-1 text-end stay-absolute" style="font-size: 0.75rem; color: #6c757d;">
                                                    <span class="stay-length" style="color: #6c757d;">@stayText2</span>, @hotel.AdultsNumber @(@hotel.AdultsNumber == 1 ? "adult" : "adults")
                                                    @if (hotel.ChildrenNumber > 0)
                                                    {
                                                        @: and @hotel.ChildrenNumber @((hotel.ChildrenNumber == 1) ? "child" : "children")
                                                    }
                                                </p>
                                                <p class="card-text mb-1 text-end"><span class="price-amount price-absolute">BGN @String.Format("{0:0.00}", hotel.Price)</span></p>
                                                <form asp-controller="BookingsCart" asp-action="AddToCart" method="post">
                                                    <input type="hidden" name="HotelName" value="@hotel.Name"/>
                                                    <input type="hidden" name="HotelImg" value="@hotel.PhotoMainUrl"/>
                                                    <input type="hidden" name="HotelPrice" value="@hotel.Price"/>
                                                    <input type="hidden" name="StartAt" value="@hotel.StartAt"/>
                                                    <input type="hidden" name="EndAt" value="@hotel.EndAt"/>
                                                    <button type="submit" class="btn btn-primary book-btn" style="background-color:#0d6efd; border-color:#0d6efd;">Book</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
    </div >

        <style>
    .hotel-card {
        border-radius: 0.75rem;
        width: 100%;
        padding-inline: 1rem;
        padding-block: 1rem;
        padding-top: 1rem; padding-bottom: 1rem; /* fallback for older browsers */
        max-width: 780px; /* even less wide */
        position: relative;
    }
    .hotel-card-img {
        object-fit: cover;
        height: 100%;
        min-height: 220px; /* ensure some height even with little text */
        border-radius: 0.5rem; /* rounded corners for the image */
    }
    .hotel-card .card-body {
        padding: 1rem 1.25rem;
    }
    .hotel-card .card-title {
        margin-bottom: 0.5rem;
    }
    span {
        color: black
    }

    .price-amount {
        font-size: 1.1rem;
        line-height: 1.1;
        color: black;
        font-weight: 550;
    }

    .review-top {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        z-index: 2;
    }
    .review-absolute {
        position: absolute;
        top: 1rem;
        right: 1.2rem;
    }
    .review-word {
        font-weight: 500;
        font-size: 0.85rem;
        line-height: 1;
        white-space: nowrap;
        /* plain text – no pill styling */
        padding: 0;
        background: none;
        border-radius: 0;
        color: inherit;
    }
    .review-label {
        display: flex;
        flex-direction: column;
        align-items: flex-end; /* right-align in a column */
        gap: 0.125rem;
        text-align: right;
    }
    .review-count {
        font-size: 0.75rem;
        color: #6c757d; /* Bootstrap secondary */
        line-height: 1;
    }
    .review-score-badge {
        background-color: #003b95;
        color: #fff;
        font-weight: 600;
        width: 37px;
        height: 37px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-top-left-radius: 0.5rem;
        border-top-right-radius: 0.5rem;
        border-bottom-right-radius: 0.5rem;
        border-bottom-left-radius: 0;
    }

    .book-btn {
        position: absolute;
        bottom: 1rem;
        right: 1.1rem;
    }
    .price-absolute {
        position: absolute;
        bottom: 4rem; /* place above the Book button */
        right: 1.1rem;
    }
    .stay-absolute {
        position: absolute;
        bottom: 5.5rem; /* above the price */
        right: 1.1rem;
    }

    .hotel-name {
        color: #0d6efd !important;
        font-weight: 700;
        position: absolute;
        top: 1.2rem;
        left: 17.80rem;
    }
    .hotel-name:hover {
        color: black !important;
    }
    .accommodation-type {
        font-size: 0.75rem;
        color: black;
        font-weight: 700;
        position: absolute;
        top: 8rem;
        left: 18.3rem;
        display: inline-block;
        border-left: 2px solid #d3d3d3;
        padding-left: 0.5rem;
        height: auto;
    }

    .city-country {
        color: black;
        position: absolute;
        top: 3rem;
        left: 17.80rem;
        font-size: 0.75rem;
    }
    .hotel-address {
        color: black;
        position: absolute;
        top: 4.2rem;
        left: 17.80rem;
        font-size: 0.75rem;
    }
    .map-info {
        position: absolute;
        top: 5.4rem;
        left: 17.80rem;
        font-size: 0.75rem;
        display: flex;
        gap: 0.5rem;
    }
    .map-info a {
        color: #0d6efd;
        text-decoration: underline;
        text-decoration-color: #0d6efd;
    }
    .map-info span {
        color: #6c757d;
    }
    .hotel-benefits {
        max-width: 240px;
        font-size: 0.75rem;
        color: #198754;
        position: absolute;
        bottom: 4.5rem;
        left: 18.3rem;
        display: inline-block;
        border-left: 2px solid #d3d3d3;
        padding-left: 0.5rem;
        height: auto;
    }
</style>
