@using HotelBooking.Services.ViewModels;
@using System.Globalization
@model List<BookingViewModel>? 

<div class="container">
<div class="row row-cols-1 g-4">
    @{
        if (Model != null)
        {
            foreach (var hotel in Model)
            {
                <div class="col">
                    <div class="card h-100 hotel-card mx-auto overflow-hidden">
                        <div class="review-top review-absolute">
                            <div class="review-label">
                                <span class="review-word">@hotel.ReviewScoreWord</span>
                                <span class="review-count">@hotel.ReviewsCount reviews</span>
                            </div>
                            <div class="review-score-badge">@Convert.ToDouble(hotel.ReviewScore, CultureInfo.InvariantCulture).ToString("0.0", CultureInfo.InvariantCulture)</div>
                        </div>
                        <div class="row g-0 align-items-stretch">
                            <div class="col-5 col-md-4">
                                <img src="@hotel.PhotoMainUrl" class="img-fluid w-100 h-100 hotel-card-img" alt="@hotel.Name">
                            </div>
                            <div class="col-7 col-md-8 d-flex">
                                <div class="card-body d-flex flex-column justify-content-between w-100">
                                    <div>
                                        <h5 class="card-title hotel-name position-absolute">@hotel.Name</h5>
                                        @{
                                            var tags = new List<string>();
                                            if (hotel.IsFreeCancellable == true) tags.Add("Cancellable");
                                            if (hotel.IsNoPrepayment == true) tags.Add("No prepayment required – pay at the property");
                                            if (hotel.HasFreeParking == true) tags.Add("Free parking");
                                        }
                                        <div class="accom-line">
                                            @if (!string.IsNullOrEmpty(hotel.AccommodationType))
                                            {
                                                <div class="card-subtitle mb-1 accommodation-type">@hotel.AccommodationType</div>
                                            }
                                            <div class="hotel-benefits">@string.Join(", ", tags)</div>
                                        </div>
                                        <div class="card-text mb-2 d-flex flex-wrap align-items-center gap-2" style="font-size: 0.75rem;">
                                            <span class="city-country">@hotel.City, @hotel.Country</span>
                                            <div class="w-100"></div>
                                            <span class="hotel-address">@hotel.Address</span>
                                            @if (hotel.Latitude != null && hotel.Longitude != null)
                                            {
                                                <div class="w-100"></div>
                                                <div class="map-info">
                                                    <a target="_blank"
                                                       href="https://www.google.com/maps/search/?api=1&query=@(hotel.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)),@(hotel.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                                        View on Map
                                                    </a>
                                                    @if (hotel.DistanceToCenter != null)
                                                    {
                                                        <span>@($"{hotel.DistanceToCenter:F1} km from city centre")</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        @if (false) { } 
                                        <div class="d-flex justify-content-end align-items-center mt-auto w-100">
                                            <div class="purchase-cta d-flex flex-column align-items-end gap-1">
                                                @{
                                                    var startDate2 = Convert.ToDateTime(hotel.StartAt, CultureInfo.InvariantCulture);
                                                    var endDate2 = Convert.ToDateTime(hotel.EndAt, CultureInfo.InvariantCulture);
                                                    var days2 = Math.Max(0, (endDate2 - startDate2).Days);
                                                    var weeks2 = (days2 >= 7 && days2 % 7 == 0) ? days2 / 7 : 0;
                                                    var stayText2 = weeks2 > 0
                                                        ? (weeks2 == 1 ? "1 week" : weeks2 + " weeks")
                                                        : (days2 == 1 ? "1 day" : days2 + " days");
                                                }
                                                <p class="card-text mb-1 text-end stay-absolute" style="font-size: 0.75rem; color: #6c757d;">
                                                    <span class="stay-length" style="color: #6c757d;">@stayText2</span>, @hotel.RoomsNumber @(@hotel.RoomsNumber == 1 ? "room" : "rooms"), @hotel.AdultsNumber @(@hotel.AdultsNumber == 1 ? "adult" : "adults")
                                                    @if (hotel.ChildrenNumber > 0)
                                                    {
                                                        @: and @hotel.ChildrenNumber @((hotel.ChildrenNumber == 1) ? "child" : "children")
                                                    }
                                                </p>
                                                <p class="card-text mb-1 text-end"><span class="price-amount price-absolute">BGN @hotel.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</span></p>
                                                <form asp-controller="BookingsCart" asp-action="AddToCart" method="post">
                                                    <input type="hidden" name="HotelName" value="@hotel.Name"/>
                                                    <input type="hidden" name="HotelImg" value="@hotel.PhotoMainUrl"/>
                                                    <input type="hidden" name="HotelPrice" value="@hotel.Price"/>
                                                    <input type="hidden" name="StartAt" value="@hotel.StartAt"/>
                                                    <input type="hidden" name="EndAt" value="@hotel.EndAt"/>
                                                    <input type="hidden" name="City" value="@hotel.City"/>
                                                    <input type="hidden" name="Country" value="@hotel.Country"/>
                                                    <input type="hidden" name="Address" value="@hotel.Address"/>
                                                    <input type="hidden" name="ReviewScore" value="@hotel.ReviewScore"/>
                                                    <input type="hidden" name="ReviewScoreWord" value="@hotel.ReviewScoreWord"/>
                                                    <input type="hidden" name="ReviewsCount" value="@hotel.ReviewsCount"/>
                                                    <input type="hidden" name="RoomsNumber" value="@hotel.RoomsNumber"/>
                                                    <input type="hidden" name="AdultsNumber" value="@hotel.AdultsNumber"/>
                                                    <input type="hidden" name="ChildrenNumber" value="@hotel.ChildrenNumber"/>
                                                    <input type="hidden" name="RapidApiHotelId" value="@hotel.HotelId"/>
                                                    <input type="hidden" name="DestinationId" value="@hotel.DestinationId"/>
                                                    <button type="submit" class="btn btn-primary book-btn">Book</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>
</div>

        <style>
    .hotel-card {
        border-radius: 0.5rem;
        width: 100%;
        padding-inline: 1rem;
        padding-block: 1rem;
        padding-top: 1rem; padding-bottom: 1rem; 
        max-width: 780px; 
        position: relative;
    }
    .hotel-card-img {
        object-fit: cover;
        height: 100%;
        min-height: 220px; 
        border-radius: 0.45rem;
    }
    .hotel-card .card-body {
        padding: 1rem 1.25rem;
    }
    .hotel-card .card-title {
        margin-bottom: 0.5rem;
    }
    .hotel-card span {
        color: black;
    }

    .price-amount {
        font-size: 1.1rem;
        line-height: 1.1;
        color: black;
        font-weight: 550;
    }

    .review-top {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        z-index: 2;
    }
    .review-absolute {
        position: absolute;
        top: 1rem;
        right: 1.2rem;
    }
    .review-word {
        font-weight: 500;
        font-size: 0.85rem;
        line-height: 1;
        white-space: nowrap;
        padding: 0;
        background: none;
        border-radius: 0;
        color: inherit;
    }
    .review-label {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.125rem;
        text-align: right;
    }
    .review-count {
        font-size: 0.75rem;
        color: #6c757d;
        line-height: 1;
    }
    .review-score-badge {
        background-color: #53B249;
        color: #fff;
        font-weight: 600;
        width: 37px;
        height: 37px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .book-btn {
        position: absolute;
        bottom: 1rem;
        right: 1.1rem;
        background-color: #53B249;
        border-color: #53B249;
    }
    .book-btn:hover {
        background-color: #3E8B37;
        border-color: #3E8B37;
    }
    .price-absolute {
        position: absolute;
        bottom: 4rem; 
        right: 1.1rem;
    }
    .stay-absolute {
        position: absolute;
        bottom: 5.5rem; 
        right: 1.1rem;
    }

    .hotel-name {
        color: #53B249 !important;
        font-weight: 700;
        position: absolute;
        top: 1.2rem;
        left: 17.80rem;
    }
    .hotel-name:hover {
        color: #3E8B37 !important;
    }
    .accommodation-type {
        font-size: 0.75rem;
        color: black;
        font-weight: 700;
    }

    .city-country {
        color: black;
        position: absolute;
        top: 3rem;
        left: 17.80rem;
        font-size: 0.75rem;
    }
    .hotel-address {
        color: black;
        position: absolute;
        top: 4.2rem;
        left: 17.80rem;
        font-size: 0.75rem;
    }
    .map-info {
        position: absolute;
        top: 5.4rem;
        left: 17.80rem;
        font-size: 0.75rem;
        display: flex;
        gap: 0.5rem;
    }
    .map-info a {
        color: #0d6efd;
        text-decoration: underline;
        text-decoration-color: #0d6efd;
    }
    .map-info span {
        color: #6c757d;
    }
    .hotel-benefits {
        max-width: 240px;
        font-size: 0.75rem;
        color: #198754;
    }
    .accom-line {
        position: absolute;
        top: 8rem;
        left: 18.3rem;
        display: flex;
        flex-direction: column;
        border-left: 2px solid #d3d3d3;
        padding-left: 0.5rem;
    }
    
    @@media (max-width: 767.98px) {
        .review-absolute {
            top: 1rem;
            right: 1.2rem; 
        }
        .review-top {
            display: flex;
            flex-direction: column; 
            align-items: flex-end;   
            gap: 0.25rem;           
        }
        .review-score-badge {
            width: 37px;  
            height: 37px;
        }
        .review-label {
            display: flex;
            flex-direction: column;
            align-items: flex-end;   
            text-align: right;
            max-width: 160px;        
            word-break: break-word;  
        }
    }
</style>

<script>
    function createBookingToast(message) {
        var container = document.getElementById('admin-toast-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'admin-toast-container';
            container.setAttribute('aria-live', 'polite');
            container.setAttribute('aria-atomic', 'false');
            document.body.appendChild(container);
        }

        var toast = document.createElement('div');
        toast.className = 'admin-toast';
        toast.setAttribute('role', 'status');

        var icon = document.createElement('div');
        icon.className = 'toast-icon';
        icon.textContent = '✓';

        var body = document.createElement('div');
        body.className = 'toast-body';
        body.textContent = message || 'Booking added to cart';

        var close = document.createElement('button');
        close.className = 'toast-close';
        close.setAttribute('aria-label', 'Close notification');
        close.type = 'button';
        close.innerHTML = '&times;';
        close.addEventListener('click', function () {
            dismiss(true);
        });

        toast.appendChild(icon);
        toast.appendChild(body);
        toast.appendChild(close);
        container.appendChild(toast);

        requestAnimationFrame(function () {
            toast.classList.add('show');
        });

        var hideTimer = setTimeout(function () {
            dismiss(false);
        }, 5000);

        function dismiss(isManual) {
            clearTimeout(hideTimer);
            toast.classList.add('hide');
            toast.classList.remove('show');
            setTimeout(function () {
                if (toast && toast.parentNode) toast.parentNode.removeChild(toast);
            }, 300);
        }
    }

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.book-btn');
        if (!btn) return;

        var form = btn.closest('form');
        var hotelName = 'Booking';
        if (form) {
            var nameInput = form.querySelector('input[name="HotelName"]');
            if (nameInput && nameInput.value) hotelName = nameInput.value;
        }

        var message = hotelName + ' booking was added to cart';
        createBookingToast(message);
    });
</script>
