@using HotelBooking.Services.ViewModels;
@model ApiDataViewModel

@{
    ViewData["Title"] = "EasyBook";
}

<div class="container mt-5 mb-5">
    <div class="hero-box">
    <h1>Find your next stay</h1>
    <h4 class="mb-5">Search low prices on hotels, homes and much more...</h4>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
      .hero-box { 
        max-width: 720px; 
        margin-inline: auto; 
      }
      @@media (min-width: 992px) {
        .hero-box { max-width: 960px; }
      }
      .form-container .form-control.equal-h,
      .form-container button.btn { width: 100%; }
      .equal-h { height: 42px; }
      .city-suggestions {
        position: absolute;
        left: 0;           
        top: calc(100% + 4px); 
        z-index: 1050;
        display: none;
        max-height: 240px;
        overflow-y: auto;
        width: 100%;
        background: #fff;
        border: 1px solid rgba(0,0,0,.125);
        border-radius: .375rem;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
      }
      .city-suggestions .suggestion-item {
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: .5rem;
      }
      .city-suggestions .suggestion-item:hover { background-color: #f8f9fa; }
      .city-suggestions .pin-icon {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        color: #6c757d; 
      }
      .city-suggestions .suggestion-text { flex: 1 1 auto; }
      .city-suggestions .suggestion-header {
        font-size: .875rem; 
        color: #000; 
        padding: .25rem .75rem;
        border-bottom: 1px solid rgba(0,0,0,.05);
        text-transform: none;
        letter-spacing: .01em;
        font-weight: 600;
      }
      #city { padding-left: 2rem; }
      .input-left-icon {
        position: absolute;
        left: .625rem;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        color: #6c757d; 
        pointer-events: none;
        z-index: 2;
      }
      #dateRange { padding-left: 2rem; }
      #guestsSummary { padding-left: 2rem; width: 260px !important; }
      #guestsSummary[readonly] { background-color: #fff !important; color: #212529; }

      #guestsPopup #guestsDone {
        display: block;
        width: 100%;
        background-color: #fff !important;
        color: #0d6efd !important;
        border: 1px solid #0d6efd !important;
        transition: background-color .15s ease, color .15s ease, border-color .15s ease, box-shadow .15s ease;
      }
      #guestsPopup #guestsDone:hover,
      #guestsPopup #guestsDone:focus {
        background-color: rgba(13,110,253,.08) !important; 
        color: #0a58ca !important;
        border-color: #0a58ca !important;
        box-shadow: none !important; 
      }
      #guestsPopup #guestsDone:active {
        background-color: rgba(13,110,253,.16) !important; 
        color: #0a58ca !important;
        border-color: #0a58ca !important;
        box-shadow: none !important;
      }

      .seg-control { display: inline-flex; align-items: center; border: 1px solid rgba(0,0,0,.08); border-radius: .5rem; background: rgba(255,255,255,.85); overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,.04); backdrop-filter: blur(3px); }
      .seg-control .seg-btn { appearance: none; border: 0; background: transparent; padding: .375rem .625rem; line-height: 1; font-size: 1rem; cursor: pointer; user-select: none; }
      .seg-control .seg-value { min-width: 2.5rem; text-align: center; padding: .25rem .75rem; font-weight: 600; }
      .seg-control .seg-btn:focus { outline: none; box-shadow: inset 0 0 0 2px rgba(13,110,253,.25); }
      .seg-control .seg-btn:active { transform: translateY(0.5px); }
      .seg-control .seg-btn[disabled] { opacity: .5; cursor: not-allowed; }


      .form-control::placeholder,
      input::placeholder,
      textarea::placeholder { color: #000 !important; opacity: 1; }

      .form-control::-webkit-input-placeholder,
      input::-webkit-input-placeholder,
      textarea::-webkit-input-placeholder { color: #000 !important; opacity: 1; }
      .form-control:-ms-input-placeholder,
      input:-ms-input-placeholder,
      textarea:-ms-input-placeholder { color: #000 !important; }
      .form-control::-ms-input-placeholder,
      input::-ms-input-placeholder,
      textarea::-ms-input-placeholder { color: #000 !important; }

      input[readonly]::placeholder { color: #000 !important; opacity: 1; }

      @@media (min-width: 901px) and (max-width: 991.98px) {
        .container {
          max-width: 960px;
        }
      }

      @@media(min-width: 768px) and (max-width: 900px) {
        .form-container {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          gap: .5rem;
          margin-top: 7rem;
          height: 11.5rem;
        }
        .form-container > .col-auto { width: 100%; }
        .form-container input {
          width: 100% !important;
        }
        #guestsSummary {
          width: 100% !important; /* override fixed 260px on mobile */
        }
        .form-container button.btn {
          width: 100%;
        }
        .flatpickr-wrapper{
          width: 100%;
        }
      }
      
       @@media(max-width: 767px) {
              .form-container {
                display: flex;
                flex-direction: column;
                align-items: stretch;
                gap: .5rem;
                margin-top: 7rem;
                height: 12.6rem;
              }
              .form-container > .col-auto { width: 100%; }
              .form-container input {
                width: 100% !important;
              }
              #guestsSummary {
                width: 100% !important; /* override fixed 260px on mobile */
              }
              .form-container button.btn {
                width: 100%;
              }
              .flatpickr-wrapper{
                        width: 100%;
              }
            }
      @@media (min-width: 992px) and (max-width: 1199.98px) {
        .form-container { width: 88%; margin-inline: auto; }
      }
      
      @@media (min-width: 900px) and (max-width: 991px){
        .form-container{
          width: 111.5%;
          margin-inline: auto;
        }
      }

      /* Popular destinations grid */
      .popular-destinations-section .destinations-container {
        width: 100%;
        height: 30rem;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      .popular-destinations-section .destinations-cell-one { grid-column: 1 / span 2; background-color: red; }
      .popular-destinations-section .destinations-cell-two { grid-column: 3; background-color: blue; }
      .popular-destinations-section .destinations-cell-three { grid-column: 1; background-color: green; }
      .popular-destinations-section .destinations-cell-four { grid-column: 2; background-color: yellow; }
      .popular-destinations-section .destinations-cell-five { grid-column: 3; background-color: purple; }

      /* Rounded corners for popular destination cells */
      .popular-destinations-section .destinations-container > div {
        border-radius: 12px; /* adjust as desired */
      }
      .popular-destinations-section .destinations-container img {
        border-radius: inherit; /* match the parent radius */
      }
      /* Ensure destination images fit their cells without overflow */
      .popular-destinations-section .destinations-container > div {
        position: relative;
        overflow: hidden; /* clip any overflow */
      }
      .popular-destinations-section .destinations-container img {
        display: block;      /* remove inline-gap */
        width: 100%;
        height: 100%;
        object-fit: cover;   /* fill cell while preserving aspect */
        transition: transform .3s ease;
      }
      .popular-destinations-section .destinations-container > div:hover img {
        transform: scale(1.05);
      }
      /* Top gradient overlay for destination cells */
      .popular-destinations-section .destinations-container > div::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom,
          rgba(0,0,0,.75) 0%,
          rgba(0,0,0,.62) 22%,
          rgba(0,0,0,.38) 44%,
          rgba(0,0,0,0) 64% /* a little above the middle */
        );
        border-radius: inherit;        /* match rounded corners */
        pointer-events: none;          /* keep cell interactions intact */
        z-index: 1;                    /* sit below the label but above the image */
      }
      /* Top-left label for destination cells */
      .popular-destinations-section .destination-label {
        position: absolute;
        top: .75rem;
        left: .75rem;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .25rem .5rem;
        color: #fff;
        border-radius: .5rem;
        font-weight: 600;
        z-index: 2;
        font-size: 1.5rem;
      }
      @@media (min-width: 992px) {
        .popular-destinations-section .destination-label {
          font-size: 1.75rem;
        }
      }
      .popular-destinations-section .destination-label .flag { line-height: 1; }
    </style>
    <form id="reservationForm" asp-action="HotelsSearch" asp-controller="Hotels" method="post">
      <div class="form-container grid-container flex-nowrap gap-1 px-1">
        <div class="col-auto position-relative">
          <input type="text" class="form-control equal-h" id="city" name="City" asp-for="@Model.City" placeholder="Where are you going?" required autocomplete="off" aria-haspopup="listbox" aria-expanded="false">
          <svg class="input-left-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M2.75 12h18.5c.69 0 1.25.56 1.25 1.25V18l.75-.75H.75l.75.75v-4.75c0-.69.56-1.25 1.25-1.25m0-1.5A2.75 2.75 0 0 0 0 13.25V18c0 .414.336.75.75.75h22.5A.75.75 0 0 0 24 18v-4.75a2.75 2.75 0 0 0-2.75-2.75zM0 18v3a.75.75 0 0 0 1.5 0v-3A.75.75 0 0 0 0 18m22.5 0v3a.75.75 0 0 0 1.5 0v-3a.75.75 0 0 0-1.5 0m-.75-6.75V4.5a2.25 2.25 0 0 0-2.25-2.25h-15A2.25 2.25 0 0 0 2.25 4.5v6.75a.75.75 0 0 0 1.5 0V4.5a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 .75.75v6.75a.75.75 0 0 0 1.5 0m-13.25-3h7a.25.25 0 0 1 .25.25v2.75l.75-.75h-9l.75.75V8.5a.25.25 0 0 1 .25-.25m0-1.5A1.75 1.75 0 0 0 6.75 8.5v2.75c0 .414.336.75.75.75h9a.75.75 0 0 0 .75-.75V8.5a1.75 1.75 0 0 0-1.75-1.75z"></path>
          </svg>
          <div id="citySuggestions" class="city-suggestions" role="listbox" aria-label="City suggestions" aria-live="polite"></div>
        </div>
        <div class="col-auto position-relative">
          <input type="text" class="form-control equal-h js-date" id="dateRange" placeholder="Check-in — Check-out" required autocomplete="off" inputmode="none" aria-label="Date range">
          <svg class="input-left-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M22.5 13.5v8.25a.75.75 0 0 1-.75.75H2.25a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75h19.5a.75.75 0 0 1 .75.75zm1.5 0V5.25A2.25 2.25 0 0 0 21.75 3H2.25A2.25 2.25 0 0 0 0 5.25v16.5A2.25 2.25 0 0 0 2.25 24h19.5A2.25 2.25 0 0 0 24 21.75zm-23.25-3h22.5a.75.75 0 0 0 0-1.5H.75a.75.75 0 0 0 0 1.5M7.5 6V.75a.75.75 0 0 0-1.5 0V6a.75.75 0 0 0 1.5 0M18 6V.75a.75.75 0 0 0-1.5 0V6A.75.75 0 0 0 18 6M5.095 14.03a.75.75 0 1 0 1.06-1.06.75.75 0 0 0-1.06 1.06m.53-1.28a1.125 1.125 0 1 0 0 2.25 1.125 1.125 0 0 0 0-2.25.75.75 0 0 0 0 1.5.375.375 0 1 1 0-.75.375.375 0 0 1 0 .75.75.75 0 0 0 0-1.5m-.53 6.53a.75.75 0 1 0 1.06-1.06.75.75 0 0 0-1.06 1.06m.53-1.28a1.125 1.125 0 1 0 0 2.25 1.125 1.125 0 0 0 0-2.25.75.75 0 0 0 0 1.5.375.375 0 1 1 0-.75.375.375 0 0 1 0 .75.75.75 0 0 0 0-1.5m5.845-3.97a.75.75 0 1 0 1.06-1.06.75.75 0 0 0-1.06 1.06m.53-1.28A1.125 1.125 0 1 0 12 15a1.125 1.125 0 0 0 0-2.25.75.75 0 0 0 0 1.5.375.375 0 1 1 0-.75.375.375 0 0 1 0 .75.75.75 0 0 0 0-1.5m-.53 6.53a.75.75 0 1 0 1.06-1.06.75.75 0 0 0-1.06 1.06M12 18a1.125 1.125 0 1 0 0 2.25A1.125 1.125 0 0 0 12 18a.75.75 0 0 0 0 1.5.375.375 0 1 1 0-.75.375.375 0 0 1 0 .75.75.75 0 0 0 0-1.5m5.845-3.97a.75.75 0 1 0 1.06-1.06.75.75 0 0 0-1.06 1.06m.53-1.28a1.125 1.125 0 1 0 0 2.25 1.125 1.125 0 0 0 0-2.25.75.75 0 0 0 0 1.5.375.375 0 1 1 0-.75.375.375 0 0 1 0 .75.75.75 0 0 0 0-1.5"/>
          </svg>
          <input type="hidden" id="checkinDate" name="CheckinDate" asp-for="@Model.CheckinDate">
          <input type="hidden" id="checkoutDate" name="CheckoutDate" asp-for="@Model.CheckoutDate">
        </div>
        <div class="col-auto position-relative">
          <input type="text" class="form-control equal-h" id="guestsSummary" placeholder="2 adults - 0 children - 1 room" readonly autocomplete="off" aria-haspopup="dialog" aria-expanded="false">
          <svg class="input-left-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="50px" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M16.5 6a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0M18 6A6 6 0 1 0 6 6a6 6 0 0 0 12 0M3 23.25a9 9 0 1 1 18 0 .75.75 0 0 0 1.5 0c0-5.799-4.701-10.5-10.5-10.5S1.5 17.451 1.5 23.25a.75.75 0 0 0 1.5 0"></path>
          </svg>

          <input type="hidden" id="adultsNumber" name="AdultsNumber" asp-for="@Model.AdultsNumber" value="2">
          <input type="hidden" id="childrenNumber" name="ChildrenNumber" asp-for="@Model.ChildrenNumber" value="0">
          <input type="hidden" id="roomNumber" name="RoomsNumber" asp-for="@Model.RoomsNumber" value="1">

          <!-- Popup for selecting counts -->
          <div id="guestsPopup" class="city-suggestions" role="dialog" aria-label="Select guests and rooms" aria-live="polite">
            <div class="px-3 py-2 d-flex justify-content-between align-items-center">
              <div>Adults</div>
              <div class="seg-control" role="group" aria-label="Adults">
                <button type="button" class="seg-btn" data-target="adults" data-op="dec" aria-label="Decrease adults">−</button>
                <div class="seg-value" id="adultsCount" aria-live="polite">2</div>
                <button type="button" class="seg-btn" data-target="adults" data-op="inc" aria-label="Increase adults">+</button>
              </div>
            </div>
            <div class="px-3 py-2 d-flex justify-content-between align-items-center">
              <div>Children</div>
              <div class="seg-control" role="group" aria-label="Children">
                <button type="button" class="seg-btn" data-target="children" data-op="dec" aria-label="Decrease children">−</button>
                <div class="seg-value" id="childrenCount" aria-live="polite">0</div>
                <button type="button" class="seg-btn" data-target="children" data-op="inc" aria-label="Increase children">+</button>
              </div>
            </div>
            <div class="px-3 py-2 d-flex justify-content-between align-items-center">
              <div>Rooms</div>
              <div class="seg-control" role="group" aria-label="Rooms">
                <button type="button" class="seg-btn" data-target="rooms" data-op="dec" aria-label="Decrease rooms">−</button>
                <div class="seg-value" id="roomsCount" aria-live="polite">1</div>
                <button type="button" class="seg-btn" data-target="rooms" data-op="inc" aria-label="Increase rooms">+</button>
              </div>
            </div>
            <div class="px-3 pb-2">
              <button type="button" class="btn btn-outline-primary btn-sm w-100 bg-white" id="guestsDone">Done</button>
            </div>
          </div>
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-primary">Search</button>
        </div>
      </div>
    </form>
    <section class="popular-destinations-section">
      <h2 class="mt-5">Popular destinations</h2>
      <div class="destinations-container">
        <div class="destinations-cell-one">
          <div class="destination-label"><span>Sofia</span><span class="flag" aria-hidden="true">🇧🇬</span><span class="visually-hidden">Bulgaria flag</span></div>
          <img src="img/Sofia.webp" alt="Sofia"/>
        </div>
        <div class="destinations-cell-two">
          <div class="destination-label"><span>Santorini</span><span class="flag" aria-hidden="true">🇬🇷</span><span class="visually-hidden">Greece flag</span></div>
          <img src="img/Santorini.jpeg" alt="Santorini"/>
        </div>
        <div class="destinations-cell-three">
          <div class="destination-label"><span>Milano</span><span class="flag" aria-hidden="true">🇮🇹</span><span class="visually-hidden">Italy flag</span></div>
          <img src="img/Milano.jpg" alt="Milano"/>
        </div>
        <div class="destinations-cell-four">
          <div class="destination-label"><span>Vienna</span><span class="flag" aria-hidden="true">🇦🇹</span><span class="visually-hidden">Austria flag</span></div>
          <img src="img/Vienna.webp" alt="Vienna"/>
        </div>
        <div class="destinations-cell-five">
          <div class="destination-label"><span>Dubrovnik</span><span class="flag" aria-hidden="true">🇭🇷</span><span class="visually-hidden">Croatia flag</span></div>
          <img src="img/Dubrovnik.webp" alt="Dubrovnik"/>
        </div>
      </div>
    </section>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        (function() {
          const dateRangeInput = document.getElementById('dateRange');
          const hiddenCheckin = document.getElementById('checkinDate');
          const hiddenCheckout = document.getElementById('checkoutDate');

          const defaults = [];
          if (hiddenCheckin && hiddenCheckin.value) defaults.push(hiddenCheckin.value);
          if (hiddenCheckout && hiddenCheckout.value) defaults.push(hiddenCheckout.value);

          const fp = flatpickr(dateRangeInput, {
            mode: 'range',
            dateFormat: 'Y-m-d',
            allowInput: true,
            static: true,
            showMonths: 2,
            monthSelectorType: 'dropdown',
            defaultDate: defaults.length ? defaults : null,
            onChange: function(selectedDates, dateStr, instance) {
              if (selectedDates[0]) {
                hiddenCheckin.value = instance.formatDate(selectedDates[0], 'Y-m-d');
              } else {
                hiddenCheckin.value = '';
              }
              if (selectedDates[1]) {
                hiddenCheckout.value = instance.formatDate(selectedDates[1], 'Y-m-d');
              } else {
                hiddenCheckout.value = '';
              }
              dateRangeInput.setCustomValidity('');
            },
          });

          document.getElementById('reservationForm').addEventListener('submit', function(e) {
            if (!hiddenCheckin.value || !hiddenCheckout.value) {
              e.preventDefault();
              dateRangeInput.setCustomValidity('Please select both check-in and check-out dates.');
              dateRangeInput.reportValidity();
              dateRangeInput.focus();
            } else {
              dateRangeInput.setCustomValidity('');
            }
          });
        })();

        const cityInput = document.getElementById('city');
        const citySuggestions = document.getElementById('citySuggestions');
        const popularCities = ['Sofia','Plovdiv','Sozopol','Varna'];
        function escapeRegExp(str) {
          return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        function renderCitySuggestions(filterText) {
          const raw = (filterText || '').trim();
          const q = raw.toLowerCase();
          const results = (() => {
            if (!q) return [...popularCities];
            const wordStart = new RegExp('(^|[\\s,\\-])' + escapeRegExp(q), 'i');
            return popularCities.filter(c => wordStart.test(c));
          })();

          if (q) {
            const starts = new RegExp('^' + escapeRegExp(q), 'i');
            results.sort((a, b) => {
              const aScore = starts.test(a) ? 0 : 1;
              const bScore = starts.test(b) ? 0 : 1;
              return aScore - bScore || a.localeCompare(b);
            });
          }

          const header = `<div class="suggestion-header">Trending destinations</div>`;

          if (results.length === 0) {
            citySuggestions.innerHTML = header + '<div class="px-3 py-2 text-muted">No matches</div>';
            return;
          }

          const hiRe = q ? new RegExp('(^|[\\s,\\-])(' + escapeRegExp(q) + ')', 'ig') : null;
          citySuggestions.innerHTML = header + results.map(c => {
            const label = hiRe ? c.replace(hiRe, (m, p1, p2) => `${p1}<mark>${p2}</mark>`) : c;
            return `
              <div class="suggestion-item px-3 py-2" role="option" data-value="${c}">
                <svg class="pin-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                </svg>
                <span class="suggestion-text">${label}</span>
              </div>`;
          }).join('');
        }

        function openCitySuggestions() {
          renderCitySuggestions(cityInput.value);
          citySuggestions.style.display = 'block';
          cityInput.setAttribute('aria-expanded', 'true');
        }
        function closeCitySuggestions() {
          citySuggestions.style.display = 'none';
          cityInput.setAttribute('aria-expanded', 'false');
        }

        cityInput.addEventListener('focus', openCitySuggestions);
        cityInput.addEventListener('click', openCitySuggestions);
        cityInput.addEventListener('input', () => {
          renderCitySuggestions(cityInput.value);
          citySuggestions.style.display = 'block';
        });
        citySuggestions.addEventListener('mousedown', (e) => {
          const item = e.target.closest('.suggestion-item');
          if (item) {
            cityInput.value = item.getAttribute('data-value');
            closeCitySuggestions();
          }
        });
        cityInput.addEventListener('blur', () => setTimeout(closeCitySuggestions, 100));
        (function () {
          const input = document.getElementById('guestsSummary');
          const popup = document.getElementById('guestsPopup');
          const adultsHidden = document.getElementById('adultsNumber');
          const childrenHidden = document.getElementById('childrenNumber');
          const roomsHidden = document.getElementById('roomNumber');
          const adultsCountEl = document.getElementById('adultsCount');
          const childrenCountEl = document.getElementById('childrenCount');
          const roomsCountEl = document.getElementById('roomsCount');
          const btnDecAdults = popup.querySelector('button[data-target="adults"][data-op="dec"]');
          const btnDecChildren = popup.querySelector('button[data-target="children"][data-op="dec"]');
          const btnDecRooms = popup.querySelector('button[data-target="rooms"][data-op="dec"]');

          let adults = parseInt(adultsHidden.value || '2', 10);
          let children = parseInt(childrenHidden.value || '0', 10);
          let rooms = parseInt(roomsHidden.value || '1', 10);

          const plural = (n, s, p) => (n === 1 ? s : p);

          function update() {
            adults = Math.max(1, adults);
            children = Math.max(0, children);
            rooms = Math.max(1, rooms);

            adultsHidden.value = adults;
            childrenHidden.value = children;
            roomsHidden.value = rooms;

            adultsCountEl.textContent = adults;
            childrenCountEl.textContent = children;
            roomsCountEl.textContent = rooms;

            btnDecAdults.disabled = adults <= 1;
            btnDecChildren.disabled = children <= 0;
            btnDecRooms.disabled = rooms <= 1;

            const text = `${adults} adults - ${children} children - ${rooms} ${plural(rooms, 'room', 'rooms')}`;
            input.value = text;
            input.placeholder = text; 
          }

          update();

          function open() {
            popup.style.display = 'block';
            input.setAttribute('aria-expanded', 'true');
          }
          function close() {
            popup.style.display = 'none';
            input.setAttribute('aria-expanded', 'false');
          }

          input.addEventListener('focus', open);
          input.addEventListener('click', open);
          document.addEventListener('pointerdown', (e) => {
            if (!popup.contains(e.target) && e.target !== input) {
              close();
            }
          });
          input.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

          popup.addEventListener('pointerdown', (e) => {
            const btn = e.target.closest('button[data-target]');
            if (!btn) return;
            const t = btn.getAttribute('data-target');
            const op = btn.getAttribute('data-op');
            const delta = op === 'inc' ? 1 : -1;
            if (t === 'adults') adults += delta;
            if (t === 'children') children += delta;
            if (t === 'rooms') rooms += delta;
            update();
            e.preventDefault();
            e.stopPropagation();
          });

          const doneBtn = document.getElementById('guestsDone');
          doneBtn.addEventListener('click', () => {
            update();
            close();
            input.blur();
          });
        })();
      });
    </script>
</div>


