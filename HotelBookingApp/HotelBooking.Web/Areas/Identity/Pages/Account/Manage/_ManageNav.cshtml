@using HotelBooking.Models.Identity
@inject SignInManager<UserModel> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<ul class="nav nav-pills flex-column">
    <li class="nav-item"><a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index" style="color: black; background-color: @(ManageNavPages.IndexNavClass(ViewContext) == "active" ? "#53B249" : "")">Profile</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email" style="color: black; background-color: @(ManageNavPages.EmailNavClass(ViewContext) == "active" ? "#53B249" : "")">Email</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword" style="color: black; background-color: @(ManageNavPages.ChangePasswordNavClass(ViewContext) == "active" ? "#53B249" : "")">Password</a></li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item"><a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins" style="color: black; background-color: @(ManageNavPages.ExternalLoginsNavClass(ViewContext) == "active" ? "#53B249" : "")">External logins</a></li>
    }
    <li class="nav-item"><a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication" style="color: black; background-color: @(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) == "active" ? "#53B249" : "")">Two-factor authentication</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData" style="color: black; background-color: @(ManageNavPages.PersonalDataNavClass(ViewContext) == "active" ? "#53B249" : "")">Personal data</a></li>
</ul>
