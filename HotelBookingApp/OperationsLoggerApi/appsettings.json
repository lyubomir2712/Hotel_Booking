{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "ops-log",
    "GroupId": "ops-writer",
    "AutoOffsetReset": "Earliest"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  
  "AllowedHosts": "*"
}
